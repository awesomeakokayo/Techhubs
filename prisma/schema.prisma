generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())

  accounts        Account[]
  sessions        Session[]
  subscription    Subscription?
  progress        UserProgress[]
  trackProgress   UserTrackProgress[]
  guidedPaths     GuidedPathEnrollment[]
  trackAccess     TrackAccess[]
  completions     CourseCompletion[]
  paymentOrders   PaymentOrder[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  PAST_DUE
  EXPIRED
  NONE
}

enum SubscriptionPlan {
  MONTHLY
  THREE_MONTHS
  YEARLY
}

model Subscription {
  id                       String              @id @default(cuid())
  userId                   String              @unique
  status                   SubscriptionStatus  @default(NONE)
  plan                     SubscriptionPlan?
  paystackCustomerCode     String?
  paystackSubscriptionCode String?
  paystackPlanCode         String?
  currentPeriodEnd         DateTime?
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([paystackSubscriptionCode])
  @@index([paystackCustomerCode])
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

model UserProgress {
  id          String         @id @default(cuid())
  userId      String
  trackId     String
  stageId     Int?
  resourceId  String?
  itemType    String
  status      ProgressStatus @default(NOT_STARTED)
  completedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, trackId, itemType, resourceId, stageId])
  @@index([userId, trackId])
}

model UserTrackProgress {
  id        String   @id @default(cuid())
  userId    String
  trackId   String
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, trackId])
  @@index([userId])
}

model GuidedPathEnrollment {
  id               String   @id @default(cuid())
  userId           String
  trackId          String
  currentStepIndex Int      @default(0)
  startedAt        DateTime @default(now())
  lastActivityAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, trackId])
}

enum AccessSource {
  PURCHASED
  GRANDFATHERED
}

enum AccessStatus {
  ACTIVE
  EXPIRED
}

enum PaymentProvider {
  PAYSTACK
  STRIPE
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  ABANDONED
  REVERSED
  REFUNDED
}

enum PricingRegion {
  NIGERIA
  INTERNATIONAL
}

model PaymentOrder {
  id                 String          @id @default(cuid())
  userId             String
  trackId            String
  plan               SubscriptionPlan
  region             PricingRegion
  currency           String
  amount             Int
  amountMajor        Int
  pricingVersion     String
  status             PaymentStatus   @default(PENDING)
  reference          String          @unique
  ipCountry          String?
  cardCountry        String?
  riskOutcome        String?
  paystackVerifiedAt DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([reference])
}

model TrackAccess {
  id          String          @id @default(cuid())
  userId      String
  trackId     String
  status      AccessStatus    @default(ACTIVE)
  source      AccessSource    @default(PURCHASED)
  provider    PaymentProvider
  plan        SubscriptionPlan
  grantedAt   DateTime        @default(now())
  expiresAt   DateTime
  providerRef String?         @unique
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, trackId])
  @@index([userId])
  @@index([expiresAt])
}

model CourseCompletion {
  id          String   @id @default(cuid())
  userId      String
  trackId     String
  completedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, trackId])
}
