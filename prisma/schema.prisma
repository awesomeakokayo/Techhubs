generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())

  accounts        Account[]
  sessions        Session[]
  subscription    Subscription?
  profile         LearnerProfile?
  progress        UserProgress[]
  trackProgress   UserTrackProgress[]
  guidedPaths     GuidedPathEnrollment[]
  trackAccess     TrackAccess[]
  trackPassPurchases TrackPassPurchase[]
  completions     CourseCompletion[]
  paymentOrders   PaymentOrder[]
  learningEvents  LearningEvent[]
  entitlementEvents EntitlementEvent[]
  notificationPreference NotificationPreference?
  notificationLogs       NotificationLog[]
  checklistProgress      ChecklistProgress[]
  assessmentBuckets      AssessmentCreditBucket[]
  assessmentReservations AssessmentCreditReservation[]
}

model LearnerProfile {
  id                  String   @id @default(cuid())
  userId              String   @unique
  primaryGoal         String?
  experienceLevel     String?
  weeklyHours         Int?
  recommendedTrackId  String?
  onboardingCompleted Boolean  @default(false)
  dailyGoalSteps      Int      @default(1)
  timeZone            String   @default("Africa/Lagos")
  plannedStudyDays    Int[]    @default([1, 2, 3, 4, 5])
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([recommendedTrackId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  PAST_DUE
  EXPIRED
  NONE
}

enum SubscriptionPlan {
  MONTHLY
  THREE_MONTHS
  YEARLY
  TRACK_PASS
}

model Subscription {
  id                       String              @id @default(cuid())
  userId                   String              @unique
  status                   SubscriptionStatus  @default(NONE)
  plan                     SubscriptionPlan?
  paystackCustomerCode     String?
  paystackSubscriptionCode String?
  paystackPlanCode         String?
  provider                 PaymentProvider?
  providerCustomerId       String?
  providerSubscriptionId   String?
  productCode              String?
  cancelAtPeriodEnd        Boolean             @default(false)
  providerUpdatedAt        DateTime?
  currentPeriodEnd        DateTime?
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([paystackSubscriptionCode])
  @@index([paystackCustomerCode])
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

model UserProgress {
  id          String         @id @default(cuid())
  userId      String
  trackId     String
  stageId     Int?
  resourceId  String?
  itemType    String
  status      ProgressStatus @default(NOT_STARTED)
  completedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, trackId, itemType, resourceId, stageId])
  @@index([userId, trackId])
  @@index([userId, completedAt])
}

model UserTrackProgress {
  id        String   @id @default(cuid())
  userId    String
  trackId   String
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, trackId])
  @@index([userId])
}

enum ChecklistKind {
  STAGE
  PROJECT
}

model ChecklistProgress {
  id          String        @id @default(cuid())
  userId      String
  trackId     String
  kind        ChecklistKind
  itemKey     String
  isCompleted Boolean       @default(false)
  completedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, trackId, kind, itemKey])
  @@index([userId, trackId])
}

model GuidedPathEnrollment {
  id               String   @id @default(cuid())
  userId           String
  trackId          String
  currentStepIndex Int      @default(0)
  startedAt        DateTime @default(now())
  lastActivityAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, trackId])
}

enum AccessSource {
  PURCHASED
  GRANDFATHERED
}

enum AccessStatus {
  ACTIVE
  EXPIRED
}

/// Lifecycle of one track-specific Track Pass purchase period.
enum TrackPassStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum PaymentProvider {
  PAYSTACK
  STRIPE
  LEMON_SQUEEZY
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  ABANDONED
  REVERSED
  REFUNDED
}

enum PricingRegion {
  NIGERIA
  INTERNATIONAL
}

model PaymentOrder {
  id                 String          @id @default(cuid())
  userId             String
  trackId            String
  plan               SubscriptionPlan
  region             PricingRegion
  currency           String
  amount             Int
  amountMajor        Int
  pricingVersion     String
  status             PaymentStatus   @default(PENDING)
  reference          String          @unique
  ipCountry          String?
  cardCountry        String?
  riskOutcome        String?
  paystackVerifiedAt DateTime?
  provider           PaymentProvider?
  productCode        String?
  providerCheckoutId String?
  providerPaymentId  String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  trackPassPurchase TrackPassPurchase?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([reference])
}

/// Auditable record of one verified track-specific Track Pass purchase period.
///
/// A Track Pass is a ONE-TIME payment that grants access to a single eligible
/// premium track for its configured track-specific calendar-month term. Each verified purchase writes exactly one row
/// here (keyed by the internal order reference, so webhook retries and duplicate
/// deliveries cannot create a second period). Historical rows are retained after
/// expiry: repurchasing appends a new period rather than overwriting history.
///
/// This table is DISTINCT from legacy `TrackAccess` rows, which predate the
/// commercial model and are not assumed to represent Track Pass purchases.
model TrackPassPurchase {
  id                String          @id @default(cuid())
  userId            String
  trackId           String
  provider          PaymentProvider
  status            TrackPassStatus @default(ACTIVE)
  /// Authoritative period start: the verified successful-payment instant (UTC).
  startedAt         DateTime
  /// Track-specific term after startedAt (UTC), stored and enforced server-side.
  expiresAt         DateTime
  /// Verified amount in minor units, retained for reconciliation.
  amount            Int
  currency          String
  pricingVersion    String?
  providerPaymentId String?
  /// Internal order reference; unique so one payment yields one period.
  orderReference    String          @unique
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  order PaymentOrder @relation(fields: [orderReference], references: [reference], onDelete: Cascade)

  @@index([userId, trackId])
  @@index([userId, expiresAt])
  @@index([status, expiresAt])
}

model TrackAccess {
  id          String          @id @default(cuid())
  userId      String
  trackId     String
  status      AccessStatus    @default(ACTIVE)
  source      AccessSource    @default(PURCHASED)
  provider    PaymentProvider
  plan        SubscriptionPlan
  grantedAt   DateTime        @default(now())
  expiresAt   DateTime
  providerRef String?         @unique
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, trackId])
  @@index([userId])
  @@index([expiresAt])
}

model CourseCompletion {
  id          String   @id @default(cuid())
  userId      String
  trackId     String
  completedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, trackId])
}

model LearningEvent {
  id        String   @id @default(cuid())
  userId    String
  eventName String
  trackId   String?
  stepId    String?
  metadata  Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, eventName])
}

/// Lifecycle of one monthly AI-assessment credit reservation.
enum AssessmentReservationStatus {
  /// Held: the learner has been granted capacity for one billable assessment.
  RESERVED
  /// The model produced a usable decision; the credit is spent.
  CONSUMED
  /// The outcome was non-billable (deterministic rejection, reuse, provider
  /// error, timeout); the credit is returned.
  RELEASED
  /// A reservation that outlived its TTL was reclaimed (see reconciliation).
  EXPIRED
}

/// One locked per-user, per-calendar-month accounting bucket.
///
/// The row exists purely to serialize capacity decisions for a single
/// user+month: `reserveAssessmentCredit` takes a `SELECT ... FOR UPDATE` lock on
/// it inside a transaction, so two concurrent workers cannot both observe spare
/// capacity and overbook it. The authoritative counts live in
/// `AssessmentCreditReservation`; the bucket also snapshots the tier/allowance
/// that applied for the period so accounting is auditable.
model AssessmentCreditBucket {
  id          String   @id @default(cuid())
  userId      String
  /// First instant of the UTC calendar month this bucket accounts for.
  periodStart DateTime
  tier        String
  allowance   Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, periodStart])
}

/// Durable reservation record for one logical billable assessment request.
///
/// `requestId` is a stable, server-derived (or client-supplied) identifier for
/// the logical request, so duplicate HTTP requests and retries cannot reserve or
/// consume more than one credit for the same assessment. Invariant enforced
/// under concurrency (with the bucket lock):
///
///   consumed + active(unexpired) reservations <= applicable monthly limit
model AssessmentCreditReservation {
  id            String                      @id @default(cuid())
  userId        String
  /// Stable idempotency key for the logical assessment request.
  requestId     String
  periodStart   DateTime
  status        AssessmentReservationStatus @default(RESERVED)
  /// Credits reserved (always 1 today; kept explicit for capacity math).
  credits       Int                         @default(1)
  tier          String
  allowance     Int
  trackId       String?
  stepId        String?
  /// After this instant an un-resolved reservation no longer blocks capacity.
  expiresAt     DateTime
  consumedAt    DateTime?
  releasedAt    DateTime?
  releaseReason String?
  createdAt     DateTime                    @default(now())
  updatedAt     DateTime                    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, requestId])
  @@index([userId, periodStart, status])
  @@index([status, expiresAt])
}

model NotificationPreference {
  id             String   @id @default(cuid())
  userId         String   @unique
  email          Boolean  @default(true)
  inApp          Boolean  @default(true)
  reminderWindow String   @default("evening")
  quietStartHour Int?
  quietEndHour   Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NotificationLog {
  id       String   @id @default(cuid())
  userId   String
  type     String
  channel  String
  sentAt   DateTime @default(now())
  metadata Json?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, sentAt])
  @@index([userId, type])
}

/// Auditable record of every entitlement-affecting provider event. The unique
/// providerEventId makes webhook processing idempotent (duplicate deliveries are
/// rejected by the constraint, not by fragile read-then-write logic).
model EntitlementEvent {
  id              String   @id @default(cuid())
  userId          String
  provider        String?
  providerEventId String?  @unique
  type            String
  planId          String?
  trackId         String?
  source          String
  metadata        Json?
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([type])
}
