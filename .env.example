# TechSkillHub environment variables (example — do not put real secrets here)
#
# Copy the variables you need into .env.local and fill in real values.
# Never commit .env.local or any file containing real credentials.

# --- Required by the app ---
DATABASE_URL="postgresql://user:password@localhost:5432/techskillhub"
AUTH_SECRET="generate-a-long-random-string"

# --- Project verification (AI-assisted assessment) ---
# The assessment provider defaults to DeepSeek Flash. Keep this key server-side
# only; do not expose it through NEXT_PUBLIC_* variables.
DEEPSEEK_API_KEY=""
# Optional overrides (defaults shown):
DEEPSEEK_MODEL="deepseek-flash"
DEEPSEEK_BASE_URL="https://api.deepseek.com"

# --- Optional: GitHub API token to raise rate limits when inspecting public repos ---
# A token is NOT required to inspect public repositories, but improves reliability.
# Never commit this value.
GITHUB_TOKEN=""

# --- Commercial (billing + entitlements). ALL gates default to the safe value. ---
# Paid checkout. Disabled unless explicitly 'true'.
COMMERCE_CHECKOUT_ENABLED="false"
# Restrict premium tracks to entitled learners. Disabled unless 'true'.
COMMERCE_ENTITLEMENTS_ENFORCED="false"
# Publish draft prices. Disabled unless 'true'.
COMMERCE_PRICES_APPROVED="false"
# Provider test-mode (sandbox) checkouts. Default false (live). Test-mode
# deliveries never grant entitlement; use only for sandbox verification.
COMMERCE_PROVIDER_TEST_MODE="false"
# Optional override of the premium track allowlist (comma-separated, validated).
# When unset, the tracked first-wave manifest (frontend, backend, python) is used.
COMMERCE_PREMIUM_TRACK_IDS=""
# In-app commercial announcement (dismissible). Shown unless 'false'.
COMMERCE_ANNOUNCEMENT="true"

# --- AI assessment allowances (cost control) ---
# Monthly allowance enforcement is ON unless explicitly 'false'.
COMMERCE_ASSESSMENT_ALLOWANCE_ENFORCED="true"

# --- Staged rollout (all OFF by default) ---
# Shadow evaluation: log proposed access decisions without changing access.
COMMERCE_SHADOW_EVAL="false"
# Controlled pilot cohort. Both flags are required for the pilot to affect anyone.
COMMERCE_PILOT_ENABLED="false"
COMMERCE_PILOT_USER_IDS=""
COMMERCE_PILOT_PERCENT="0"
# Explicit phase override (0-4). Empty derives the phase from the flags above.
COMMERCE_ROLLOUT_PHASE=""

# --- Existing-user transition (all OFF/inert by default) ---
# GRANDFATHERING/ENFORCED require a cutoff or a grandfathering deadline to apply.
COMMERCE_TRANSITION_MODE="OPEN"
COMMERCE_GRANDFATHERING_CUTOFF=""
COMMERCE_GRANDFATHERING_UNTIL=""
COMMERCE_TRANSITION_GRACE_DAYS="0"
COMMERCE_TRANSITION_NOTICE_DAYS="0"
