# TechSkillHub environment variables (example — do not put real secrets here)
#
# Copy the variables you need into .env.local and fill in real values.
# Never commit .env.local or any file containing real credentials.

# --- Required by the app ---
DATABASE_URL="postgresql://user:password@localhost:5432/techskillhub"
AUTH_SECRET="generate-a-long-random-string"

# --- Authentication (Google OAuth) ---
# Create an OAuth client in Google Cloud Console and register the callback:
#   http://localhost:3000/api/auth/callback/google   (local)
#   https://techskillhub.cv/api/auth/callback/google (production)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Public origin used by NextAuth. Set to the deployed origin in production.
NEXTAUTH_URL="http://localhost:3000"
AUTH_URL="http://localhost:3000"

# --- Project verification (AI-assisted assessment) ---
# The assessment provider defaults to DeepSeek Flash. Keep this key server-side
# only; do not expose it through NEXT_PUBLIC_* variables.
DEEPSEEK_API_KEY=""
# Optional overrides (defaults shown):
DEEPSEEK_MODEL="deepseek-flash"
DEEPSEEK_BASE_URL="https://api.deepseek.com"

# --- Optional: GitHub API token to raise rate limits when inspecting public repos ---
# A token is NOT required to inspect public repositories, but improves reliability.
# Never commit this value.
GITHUB_TOKEN=""

# --- Contact form email (Nodemailer/SMTP) ---
# Use an app-specific password, never the mailbox password.
SMTP_USER=""
SMTP_PASS=""
CONTACT_EMAIL="hello@techskillhub.cv"
ADMIN_EMAIL="hello@techskillhub.cv"

# --- Payment providers ---
# Lemon Squeezy (primary). Leave empty until sandbox/production credentials are approved.
LEMONSQUEEZY_API_KEY=""
LEMONSQUEEZY_STORE_ID=""
LEMONSQUEEZY_VARIANT_TRACK_PASS=""
LEMONSQUEEZY_VARIANT_PRO_MONTHLY=""
LEMONSQUEEZY_VARIANT_PRO_QUARTERLY=""
LEMONSQUEEZY_VARIANT_PRO_ANNUAL=""
LEMONSQUEEZY_WEBHOOK_SECRET=""
# Paystack. Track Pass is a one-time charge. Pro requires recurring plan codes
# created in Paystack with amounts exactly matching the approved NGN prices.
PAYSTACK_SECRET_KEY=""
PAYSTACK_PLAN_CODE_PRO_MONTHLY=""
PAYSTACK_PLAN_CODE_PRO_QUARTERLY=""
PAYSTACK_PLAN_CODE_PRO_ANNUAL=""

# --- Commercial (billing + entitlements). ALL gates default to the safe value. ---
# Paid checkout. Disabled unless explicitly 'true'.
COMMERCE_CHECKOUT_ENABLED="false"
# Restrict premium tracks to entitled learners. Disabled unless 'true'.
COMMERCE_ENTITLEMENTS_ENFORCED="false"
# Publish/charge approved catalogue prices. Disabled unless 'true'.
COMMERCE_PRICES_APPROVED="false"
# Pro recurring billing requires a matching Paystack plan code and both explicit
# flags. Set VERIFIED=true only after successful sandbox lifecycle tests.
COMMERCE_PAYSTACK_PRO_SUBSCRIPTIONS_ENABLED="false"
COMMERCE_PAYSTACK_PRO_SUBSCRIPTIONS_VERIFIED="false"
# Founding Learner offer: no promotion/countdown unless enabled and both real
# timestamps are set with a timezone offset. Configure the sale in Africa/Lagos.
COMMERCE_FOUNDING_OFFER_ENABLED="false"
COMMERCE_FOUNDING_OFFER_STARTS_AT=""
COMMERCE_FOUNDING_OFFER_ENDS_AT=""
# Provider test-mode (sandbox) checkouts. Default false (live). Test-mode
# deliveries never grant entitlement; use only for sandbox verification.
COMMERCE_PROVIDER_TEST_MODE="false"
# Optional override of the premium track allowlist (comma-separated, validated).
# When unset, the tracked first-wave manifest (frontend, backend, python) is used.
COMMERCE_PREMIUM_TRACK_IDS=""
# In-app commercial announcement (dismissible). Shown unless 'false'.
COMMERCE_ANNOUNCEMENT="true"

# --- AI assessment allowances (cost control) ---
# Monthly allowance enforcement is ON unless explicitly 'false'.
COMMERCE_ASSESSMENT_ALLOWANCE_ENFORCED="true"

# --- Staged rollout (all OFF by default) ---
# Shadow evaluation: log proposed access decisions without changing access.
COMMERCE_SHADOW_EVAL="false"
# Controlled pilot cohort. Both flags are required for the pilot to affect anyone.
COMMERCE_PILOT_ENABLED="false"
COMMERCE_PILOT_USER_IDS=""
COMMERCE_PILOT_PERCENT="0"
# Explicit phase override (0-4). Empty derives the phase from the flags above.
COMMERCE_ROLLOUT_PHASE=""

# --- Existing-user transition (all OFF/inert by default) ---
# GRANDFATHERING/ENFORCED require a cutoff or a grandfathering deadline to apply.
COMMERCE_TRANSITION_MODE="OPEN"
COMMERCE_GRANDFATHERING_CUTOFF=""
COMMERCE_GRANDFATHERING_UNTIL=""
COMMERCE_TRANSITION_GRACE_DAYS="0"
COMMERCE_TRANSITION_NOTICE_DAYS="0"

# --- End-to-end tests (Playwright) ---
# MUST point at a disposable database (Neon branch or local PostgreSQL).
# playwright.config.ts requires an explicit disposable E2E_DATABASE_URL and refuses
# to run if its normalized target matches a configured shared database. Never use production.
E2E_DATABASE_URL=""
